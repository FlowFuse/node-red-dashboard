{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["es2020"],
        "module": "node16",
        "moduleResolution": "node16",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"]
    },
    "include": ["**/*.ts", "**/*.js"]
}
